+/* Host experiment: distinguish no battery memory from an actual failure. */
+int hc_stock_save_status(void)
+{
+   unsigned i, attempted = 0;
+   bool success = true;
+
+   /* Disabled or uninitialized SRAM is not evidence of a no-SRAM game. */
+   if (!rarch_ctl(RARCH_CTL_IS_SRAM_USED, NULL) ||
+       rarch_ctl(RARCH_CTL_IS_SRAM_SAVE_DISABLED, NULL))
+      return 'F';
+   if (!task_save_files)
+      return 'F';
+   if (!task_save_files->size)
+      return 'F';
+
+   for (i = 0; i < task_save_files->size; i++)
+   {
+      struct ram_type ram;
+      retro_ctx_memory_info_t info = {0};
+      if (!content_get_memory(&info, &ram, i))
+      {
+         if (info.size)
+            success = false;
+         continue;
+      }
+      attempted++;
+      if (!content_save_ram_file(i))
+         success = false;
+   }
+
+   return !success ? 'F' : attempted ? 'S' : 'N';
+}
